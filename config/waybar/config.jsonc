{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "mpris",
        "pulseaudio",
        "network",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "tray",
        "custom/screenshot",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "󰋜",
            "2": "󰖟",
            "3": "󰅩",
            "4": "󰭹",
            "5": "󰎄",
            "6": "󰙯",
            "7": "󰓓",
            "8": "󰢹",
            "9": "󰣇",
            "urgent": "󰗖",
            "focused": "󰮯",
            "default": "󰊠"
        },
        "persistent-workspaces": {
            "*": 9
        },
        "on-click": "activate",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1",
        "sort-by-number": true
    },

    "hyprland/window": {
        "format": "  {title}",
        "max-length": 40,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹 $1",
            "(.*) - nvim": "󰕷 $1",
            "": "󰧹 Desktop"
        }
    },

    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃶 {:%d %B %Y, %A}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months":   "<span color='#f0e6e6'><b>{}</b></span>",
                "days":     "<span color='#cdd6f4'>{}</span>",
                "weeks":    "<span color='#6c7086'><b>W{}</b></span>",
                "weekdays": "<span color='#4e6e4e'><b>{}</b></span>",
                "today":    "<span color='#ac6e7e'><b><u>{}</u></b></span>"
            }
        }
    },

    "mpris": {
        "format": "{player_icon} {title}",
        "format-paused": "{status_icon} {title}",
        "player-icons": {
            "default": "󰎈",
            "spotify": "󰓇",
            "mpd": "󰎵",
            "firefox": "󰈹"
        },
        "status-icons": {
            "paused": "󰏤"
        },
        "max-length": 30,
        "ellipsis": "…",
        "tooltip-format": "{player}: {title} — {artist}\n{album}\n{position}/{length}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-bluetooth": "󰂯 {volume}%",
        "format-bluetooth-muted": "󰂲",
        "format-muted": "󰖁",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󱡒",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%",
        "tooltip-format": "{desc}: {volume}%",
        "scroll-step": 2
    },

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-linked": "󰤭 {ifname}",
        "format-disconnected": "󰤮 No network",
        "format-alt": "󰤨 {ipaddr}/{cidr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "on-click-right": "nm-connection-editor",
        "interval": 5
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "format-alt": "󰻠 {avg_frequency}GHz",
        "interval": 3,
        "on-click": "kitty --class=htop -e htop"
    },

    "memory": {
        "format": "󰘛 {percentage}%",
        "format-alt": "󰘛 {used:0.1f}G / {total:0.1f}G",
        "tooltip-format": "Used: {used:0.1f} GiB\nAvail: {avail:0.1f} GiB\nTotal: {total:0.1f} GiB",
        "interval": 5,
        "on-click": "kitty --class=htop -e htop"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "󰔏 {temperatureC}°C",
        "format-critical": "󰸁 {temperatureC}°C",
        "interval": 5
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8,
        "show-passive-items": true
    },

    "custom/screenshot": {
        "format": "󰹑",
        "tooltip": true,
        "tooltip-format": "LMB: area → swappy\nRMB: fullscreen → clipboard",
        "on-click": "~/.config/scripts/screenshot.sh area",
        "on-click-right": "~/.config/scripts/screenshot.sh full"
    },

    "custom/power": {
        "format": "󰐥",
        "tooltip": false,
        "on-click": "wlogout --protocol layer-shell",
        "on-click-right": "systemctl suspend"
    }
}
